# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ── Database (Supabase PostgreSQL — direct connection) ────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── Anthropic AI ──────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Paystack ──────────────────────────────────────────────────────
# Paystack has no separate webhook secret — the secret key below signs
# both API requests and webhook payloads.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_SECRET_KEY="sk_test_..."

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY="re_..."
ADMIN_EMAIL="admin@oleatechnologies.com"

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://oleatechnologies.com"
